{
  "name": "chat-codex",
  "version": "0.3.0",
  "private": true,
  "description": "ChatGPT-native MCP development workspace with typed Hosts and disposable Docker Environments",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/integration.mjs",
    "test:host": "node --test test/host.test.mjs",
    "test:all": "npm test && npm run test:integration",
    "test:plugin": "node --test test/plugin.test.mjs",
    "test:provider": "node --test test/provider-contract.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}